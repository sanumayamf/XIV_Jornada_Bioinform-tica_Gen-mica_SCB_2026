# 0. Setup

## Libraries
```{r libraries}
library(tidyverse)   # includes dplyr, readr, ggplot2, tidyr, stringr, forcats
library(ggpubr)      # theme_pubr(), get_legend()
library(patchwork)   # to combine the panels of Figure 2
```

## Data loading
```{r data_loading}
# BED files: one row = one ERV insertion (locus)
bed_cols <- c("chrom", "start", "end", "name", "strand")

h_internal_regions <- read_tsv("data/HERV_internal_v5.bed",
                               col_names = bed_cols, col_types = "ciicdc")
m_internal_regions <- read_tsv("data/ERV_mouse_internal.bed",
                               col_names = bed_cols, col_types = "ciicdc")

# TSV files: one row = one protein-domain hit
h_loci_domains <- read_tsv("data/HERV_loci_annotated_domains.tsv")
m_loci_domains <- read_tsv("data/ERV_mouse_loci_annotated_domain.tsv")
```

## Constants
* Fixed values for the whole document. If you change one, all figures are updated.
```{r constants}
species_colours   <- c("Human" = "#0B2545", "Mouse" = "#5B8DB8")
canonical_domains <- c("AP", "DUT", "ENV", "GAG", "INT", "RNaseH", "RT")  # 7 types
high_threshold    <- 0.70   # coverage above which a hit is considered "highly preserved"
```

## Shared tables
* `coverage_all`: all domain hits from both species (Figure 2, panel A).
* `hits_typed`: only the hits from the 7 canonical domain types. Columns:
  * Species: Human or Mouse.
  * Coverage: fraction of the domain model covered by the hit.
  * Token: the text before the first "_" in the domain name (e.g. GAG_betaretroviridae -> GAG).
  * Domain_type: the matching canonical type. Names that don't match (such as GAGCOAT_... or ORFQ_...) become NA and are removed.

```{r common_tables}
coverage_all <- bind_rows(
  h_loci_domains %>% select(Coverage) %>% mutate(Species = "Human"),
  m_loci_domains %>% select(Coverage) %>% mutate(Species = "Mouse")
) %>%
  filter(!is.na(Coverage))

hits_typed <- bind_rows(
  h_loci_domains %>% select(Domain, Coverage) %>% mutate(Species = "Human"),
  m_loci_domains %>% select(Domain, Coverage) %>% mutate(Species = "Mouse")
) %>%
  filter(!is.na(Coverage)) %>%
  mutate(
    Token = str_extract(Domain, "^[^_]+"),
    Domain_type = canonical_domains[match(toupper(Token), toupper(canonical_domains))]
  ) %>%
  filter(!is.na(Domain_type)) %>%
  mutate(Domain_type = factor(Domain_type, levels = canonical_domains))
```

