## Figure 4: effect size across domains

### Cliff's delta calculation
* Cliff's delta ranges from -1 to 1: it is the probability that a mouse hit has higher
  coverage than a human hit, minus the probability of the opposite. 0 = no difference.
* The 95% confidence interval is estimated by bootstrap (300 resamples).
  This is the slowest part of the document.

```{r cliff_delta}
set.seed(1)

# Cliff's delta: x = mouse, y = human.
# wilcox.test() gives W = pairs with x > y, plus half the ties.
cliff_delta <- function(x, y) {
  W <- suppressWarnings(wilcox.test(x, y, exact = FALSE)$statistic)
  unname(2 * W / (length(x) * length(y)) - 1)
}

cliff_results <- hits_typed %>%
  group_by(Domain_type) %>%
  group_modify(~{
    mouse <- .x$Coverage[.x$Species == "Mouse"]
    human <- .x$Coverage[.x$Species == "Human"]

    # Bootstrap: resample each group with replacement 300 times.
    boot <- replicate(300, {
      cliff_delta(sample(mouse, replace = TRUE), sample(human, replace = TRUE))
    })

    tibble(
      delta = cliff_delta(mouse, human),
      ci_low = unname(quantile(boot, 0.025)),
      ci_high = unname(quantile(boot, 0.975)),
      n_mouse = length(mouse),
      n_human = length(human)
    )
  }) %>%
  ungroup()

print(cliff_results)
```

### Figure 4A: lollipop plot (Cliff's delta)

* For each domain type, a "stick" from 0 to the Cliff's delta value, with a point at the end.
* The colour shows the direction of the difference: if delta is positive, mouse has higher coverage (mouse colour); if negative, human has higher coverage (human colour).
* The thin grey line through the point is the 95% confidence interval (bootstrap from the previous chunk).

```{r fig4a_lollipop_cliff}
# ------------------------------------------------------------------
# STEP 1: prepare the data
#   - direction: which species has higher coverage, to colour the lollipop
#   - Domain_type ordered by delta, so the plot is sorted
# ------------------------------------------------------------------
cliff_lollipop <- cliff_results %>%
  mutate(direction   = if_else(delta > 0, "Mouse higher", "Human higher"),
         Domain_type = fct_reorder(Domain_type, delta))

# Colours: one per species (species_colours, defined at the start)
direction_colours <- c("Mouse higher" = species_colours[["Mouse"]],
                       "Human higher" = species_colours[["Human"]])

# ------------------------------------------------------------------
# STEP 2: the plot
#   geom_segment()   draws the "stick" (from x = 0 to x = delta)
#   geom_errorbarh() draws the confidence interval (thin grey line)
#   geom_point()     draws the point at the end of the stick
#   geom_text()      writes the delta value after the confidence interval
#                    (to the right if positive, to the left if negative)
#   No legend: the meaning of the colour is explained on the x-axis.
# ------------------------------------------------------------------
p4a_lollipop <- ggplot(cliff_lollipop, aes(x = delta, y = Domain_type, colour = direction)) +
  geom_vline(xintercept = 0, colour = "grey50") +
  geom_segment(aes(x = 0, xend = delta, yend = Domain_type), linewidth = 1.5) +
  geom_errorbarh(aes(xmin = ci_low, xmax = ci_high), height = 0, linewidth = 0.5,
                 colour = "grey40") +
  geom_point(size = 6) +
  geom_text(aes(x     = if_else(delta > 0, ci_high, ci_low),
                label = sprintf("%.2f", delta),
                hjust = if_else(delta > 0, -0.6, 1.6)),
            size = 5.6, colour = "grey20") +
  scale_colour_manual(values = direction_colours, guide = "none") +
  scale_x_continuous(expand = expansion(mult = c(0.05, 0.15))) +   # space for the labels
  labs(x = "Effect size (Cliff's delta)\npositive = higher domain coverage in mouse",
       y = "Domain type") +
  theme_pubr(base_size = 19) +
  theme(panel.grid.major.y = element_line(colour = "grey92"))

p4a_lollipop

dir.create("figures", showWarnings = FALSE)
ggsave("figures/poster1_fig4a_cliff_lollipop.pdf", p4a_lollipop, width = 9, height = 6, device = cairo_pdf)
ggsave("figures/poster1_fig4a_cliff_lollipop.png", p4a_lollipop, width = 9, height = 6, dpi = 300)
```

### Figure 4B: shift map (percentage points)
* For each domain type, the difference between the fraction of highly preserved hits
  (>= 70%) in mouse and in human.

```{r fig4b_shift_map}
shift_map <- hits_typed %>%
  group_by(Domain_type, Species) %>%
  summarise(fraction = mean(Coverage >= high_threshold), .groups = "drop") %>%
  pivot_wider(names_from = Species, values_from = fraction) %>%
  mutate(shift = Mouse - Human)

p4b <- ggplot(shift_map,
              aes(x = "Mouse - Human",
                  y = fct_reorder(Domain_type, shift),
                  fill = shift)) +
  geom_tile(colour = "white", linewidth = 1, width = 0.6) +
  geom_text(aes(label = sprintf("%+.1f pp", 100 * shift)),
            size = 6.1, colour = "grey10") +
  scale_fill_gradient2(
    low = "#0B2545", mid = "white", high = "#5B8DB8", midpoint = 0,
    guide = "none"
  ) +
  labs(x = NULL, y = "Domain type") +
  theme_pubr(base_size = 19) +
  theme(
    axis.line = element_blank(),
    axis.ticks = element_blank(),
    axis.text.x = element_text(face = "bold")
  )

p4b

