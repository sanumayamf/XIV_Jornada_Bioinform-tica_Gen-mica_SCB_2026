## Figure 2: domain coverage distribution
* Panel A: coverage distribution of all domain hits.
* Panel B: one panel per canonical domain type. Only the bottom row
  (DUT, ENV and RNaseH) shows the x-axis percentages.

```{r fig2}
# Panel A: general coverage
pA <- ggplot(coverage_all, aes(x = Coverage, fill = Species)) +
  geom_density(alpha = 0.5, colour = NA) +
  scale_fill_manual(values = species_colours) +
  scale_x_continuous(labels = scales::percent_format(accuracy = 1)) +
  labs(x = NULL, y = "Density") +
  theme_pubr(base_size = 22) +
  theme(
    legend.position = "none",
    axis.title.y = element_text(size = 25),
    axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1)
  )

# Domain panels
# show_x_labels = TRUE  -> shows the % numbers on the x-axis (bottom row)
# show_x_labels = FALSE -> keeps the tick marks but hides the numbers (top rows)
make_domain_plot <- function(d, show_x_labels = FALSE) {
  x_text <- if (show_x_labels) {
    element_text(angle = 45, hjust = 1, vjust = 1, size = 21)
  } else {
    element_blank()
  }

  hits_typed %>%
    filter(Domain_type == d) %>%
    ggplot(aes(x = Coverage, fill = Species)) +
    geom_density(alpha = 0.5, colour = NA) +
    scale_fill_manual(values = species_colours) +
    scale_x_continuous(labels = scales::percent_format(accuracy = 1)) +
    labs(title = d, x = NULL, y = NULL) +
    theme_pubr(base_size = 18) +
    theme(
      legend.position = "none",
      plot.title = element_text(face = "bold", hjust = 0.5, size = 21),
      axis.text.x = x_text
    )
}

# Top rows: no % numbers (tick marks are kept)
pAP     <- make_domain_plot("AP")
pGAG    <- make_domain_plot("GAG")
pINT    <- make_domain_plot("INT")
pRT     <- make_domain_plot("RT")

# Bottom row: % numbers shown
pDUT    <- make_domain_plot("DUT", show_x_labels = TRUE)
# ENV: fixed breaks so it starts at 25%, like DUT and RNaseH
# (R shows a message saying the x scale is replaced; this is expected)
pENV    <- make_domain_plot("ENV", show_x_labels = TRUE) +
