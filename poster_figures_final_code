```
* This builds one table with every domain hit from both species. Each row is one hit, with these columns:
  * Species: Human or Mouse.
  * Coverage: how much of the domain model the hit covers.
  * Token: the text before the first underscore in the domain name. For example, GAG_betaretroviridae gives GAG.
  * Domain_type: the matching canonical type. Names that don’t match (such as GAGCOAT_... or ORFQ_...) get NA, and those rows are removed.
  
```{r}
hits_typed <- bind_rows(
  h_loci_domains %>% select(Domain, Coverage) %>% mutate(Species = "Human"),
  m_loci_domains %>% select(Domain, Coverage) %>% mutate(Species = "Mouse")
) %>%
  filter(!is.na(Coverage)) %>%
  mutate(
    Token = str_extract(Domain, "^[^_]+"),
    Domain_type = canonical_domains[match(toupper(Token), toupper(canonical_domains))]
  ) %>%
  filter(!is.na(Domain_type)) %>%
  mutate(Domain_type = factor(Domain_type, levels = canonical_domains))
```

## 2. Merging Data frames
* We are merging the Data Frames (With ID Suffix Fix)

### 2.1 Humans
```{r}
# 1. Clean IDs and summarize the human domains per unique region
human_domain_summary <- h_loci_domains %>%
  mutate(Cleaned_Query = sub("_strand_([+-]).*", "_strand_\\1", Query)) %>%
  group_by(Cleaned_Query) %>%
  summarise(
    num_domains = n(),
    domain_architecture = paste0(Domain, "(", round(Coverage, 2), ")", collapse = ";"),
    mean_coverage = mean(Coverage, na.rm = TRUE),
    max_coverage = max(Coverage, na.rm = TRUE)
  )

# 2. Join using the clean IDs
human_centric_table <- h_internal_regions %>%
  left_join(human_domain_summary, by = c("name" = "Cleaned_Query")) %>%
  mutate(
    num_domains = replace_na(num_domains, 0),
    domain_architecture = replace_na(domain_architecture, "None"),
    mean_coverage = replace_na(mean_coverage, 0),
    max_coverage = replace_na(max_coverage, 0)
  ) %>%
  select(-strand) %>%       # Drops the column filled with 0s
  rename(strand = X6)       # Renames the real strand column (X6) to "strand"

print(paste("Total human rows:", nrow(human_centric_table)))

table(human_centric_table$num_domains)
```

